# Test mode only. Never commit .env or expose the secret to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=
GEMINI_API_KEY=
# Optional; leave unset to use the existing provider fallback chain.
# GEMINI_MODEL=
# Required to expose operator APIs beyond localhost. Use a random 32+ character secret.
RECOVERY_ADMIN_TOKEN=
RECOVERY_TOKEN_SECRET=
RECOVERY_PUBLIC_URL=http://localhost:8000
# Comma separated hostnames accepted by the web server.
RECOVERY_HOSTS=localhost,127.0.0.1,testserver
